TELEGRAM_BOT_TOKEN=your-bot-token-here
# The bot's username, without the @; the web app's order sheet links to the
# order in the bot's chat with it. Unset = no link
TELEGRAM_BOT_USERNAME=
# "~" is expanded, so one value works on every machine; keep it outside
# iCloud-synced dirs. Relative paths depend on cwd.
RIDE_DB_PATH=~/.ride-dispatch/orders.db
RIDE_WEB_PORT=3200
# Telegram chat IDs the bot answers, comma-separated; empty = anyone
ALLOWED_CHAT_IDS=
# Chat every push goes to (flight, reminders, parking, credits); unset = the
# first of ALLOWED_CHAT_IDS, and with both blank nothing is ever pushed
NOTIFY_CHAT_ID=
# fal.ai API key for whiteboard sign generation; unset = feature off
FAL_KEY=
# Car plate to watch in the HKIA car parks; unset = parking feature off
CAR_PLATE=
# Optional; email HKIA attaches to an online parking payment, blank is accepted
PARKING_EMAIL=
# Address the web app is opened at, e.g. https://ride.example.com; the bot's
# notice of a bank credit then carries a link to that credit on the settle
# page. Unset = the notice has no link
RIDE_WEB_URL=
# Path to first-reader's published bank credit feed (JSONL); unset = ledger off,
# and no batch can become paid
BANK_CREDITS_FEED=
