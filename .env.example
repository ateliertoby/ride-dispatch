TELEGRAM_BOT_TOKEN=your-bot-token-here
# "~" is expanded, so one value works on every machine; keep it outside
# iCloud-synced dirs. Relative paths depend on cwd.
RIDE_DB_PATH=~/.ride-dispatch/orders.db
RIDE_WEB_PORT=3200
ALLOWED_CHAT_IDS=
# fal.ai API key for whiteboard sign generation; unset = feature off
FAL_KEY=
# Car plate to watch in the HKIA car parks; unset = parking feature off
CAR_PLATE=
# Optional; email HKIA attaches to an online parking payment, blank is accepted
PARKING_EMAIL=
# Path to first-reader's published bank credit feed (JSONL); unset = ledger off,
# and no batch can become paid
BANK_CREDITS_FEED=
