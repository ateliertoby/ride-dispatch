TELEGRAM_BOT_TOKEN=your-bot-token-here
# "~" is expanded, so one value works on every machine; keep it outside
# iCloud-synced dirs. Relative paths depend on cwd.
RIDE_DB_PATH=~/.ride-dispatch/orders.db
RIDE_WEB_PORT=3200
ALLOWED_CHAT_IDS=
# fal.ai API key for whiteboard sign generation; unset = feature off
FAL_KEY=
