[Unit]
Description=ride-dispatch Cloudflare tunnel
After=network-online.target
Wants=network-online.target

[Service]
User=toby
# Run by tunnel UUID: name resolution would need the account cert.pem, the
# credentials file alone is enough for the UUID form. Replace the zeros with
# the tunnel's own UUID.
ExecStart=/usr/bin/cloudflared tunnel --config /home/toby/.cloudflared/ride-dispatch.yml run 00000000-0000-0000-0000-000000000000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
